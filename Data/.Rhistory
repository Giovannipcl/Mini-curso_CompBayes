fit <- model$sample(data=dat, seed=123, chains = 1, parallel_chains = 1, iter_warmup = 1000,iter_sampling = 3000,
thin = 1, save_warmup = FALSE)
posterior_mat <- as_draws_matrix(fit$draws("w"))
lr = "
data {
int<lower=0> N;        // número de observações
int<lower=0> D;        // número de variáveis
matrix[N, D] X;        // matriz de preditores
vector[N] y;           // vetor de respostas
}
parameters {
vector[D] w;                 // coeficientes da regressão
real beta0;
vector<lower=0>[D] alpha;    // precisões individuais para ARD
real<lower=0> sigma;         // desvio padrão do erro
}
model {
// priors
alpha ~ gamma(1, 1);
sigma ~ inv_gamma(1, 1);
w ~ normal(0, sigma ./ sqrt(alpha));  // escala depende de cada alpha
// likelihood
y ~ normal(X * w, sigma);
}
"
set.seed(1)
# Parâmetros
p <- 250      # número de covariáveis
N <- 10000     # tamanho amostral
sparsity <- 0.5  # proporção de zeros em beta
# Número de zeros e não-zeros
n_zeros <- round(sparsity * p)
n_nonzero <- p - n_zeros
# Vetor beta esparso
beta_true <- c(rnorm(n_nonzero, mean = 0, sd = 1), rep(0, n_zeros))
beta_true <- sample(beta_true)  # embaralha
beta_true[1] <- -0.1            # força o intercepto ou primeiro coeficiente
# Matriz X
X <- matrix(rnorm(N * (p-1)), nrow = N, ncol = p-1)
X <- cbind(1, X)  # primeira coluna de 1s
y <- as.vector(X %*% beta_true + rnorm(N, mean = 0, sd = 1))
### treino e teste
# proporção treino/teste
train_frac <- 0.7
N <- nrow(X)
train_idx <- sample(1:N, size = round(train_frac * N), replace = FALSE)
test_idx <- setdiff(1:N, train_idx)
# dados de treino
X_train <- X[train_idx, ]
y_train <- y[train_idx]
# dados de teste
X_test <- X[test_idx, ]
y_test <- y[test_idx]
dat = list(N = N, X = X_train, y = y_train,D =ncol(X_train))
model <- cmdstan_model(write_stan_file(lr))
fit <- model$sample(data=dat, seed=123, chains = 1, parallel_chains = 1, iter_warmup = 1000,iter_sampling = 3000,
thin = 1, save_warmup = FALSE)
