dat = list(N = nrow(X_train), X = X_train, y = y_train,D =ncol(X_train))
model <- cmdstan_model(write_stan_file(lr))
fit <- model$sample(data=dat, seed=123, chains = 1, parallel_chains = 1, iter_warmup = 1000,iter_sampling = 3000,
thin = 1, save_warmup = FALSE)
fit_vb <- model$variational(
data = dat,
seed = 123,
algorithm = "meanfield",  # ou "fullrank"
iter = 30000              # número de iterações para convergência
)
posterior_mat <- as_draws_matrix(fit$draws("w"))
posterior_mat_vb <- as_draws_matrix(fit_vb$draws("w"))
posterior_hyper_vb <- as_draws_matrix(fit_vb$draws("sigma"))
plot(apply(posterior_mat,2,mean),apply(posterior_mat_vb,2,mean))
